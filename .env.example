# Neon PostgreSQL connection string (pooled or direct)
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/appoflex?sslmode=require

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Groq powers the AI features (message drafts, booking assistant)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Public URL of the app, used for links in emails
APP_URL=http://localhost:3000

# Email (password reset). Any SMTP provider works. Leave SMTP_HOST empty in development
# and the email is printed in the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AppoFlex <no-reply@example.com>
