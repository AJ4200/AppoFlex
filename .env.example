# Neon PostgreSQL connection string (pooled or direct)
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/appoflex?sslmode=require

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Groq powers the AI features (message drafts, booking assistant)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
